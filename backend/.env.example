# ========================================================================
# Food Store API - Variables de Entorno
# ========================================================================
# Copia este archivo como .env y rellena con tus valores

# Base de datos
# Para SQLite (por defecto, no requiere instalación adicional):
DATABASE_URL=sqlite:///./test.db

# Para PostgreSQL (requiere servidor PostgreSQL corriendo):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/foodstore_db

# FastAPI Server Configuration (opcional)
API_HOST=0.0.0.0
API_PORT=8000

# Debug Mode (usar True solo en desarrollo)
DEBUG=False

# CORS Configuration (permitir acceso desde frontend)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
